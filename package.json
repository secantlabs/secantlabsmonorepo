{
  "name": "secantlabs",
  "private": true,
  "version": "0.0.1",
  "description": "Secant Labs: Warp and the other interactive tools, the shared math engine, and the umbrella site.",
  "homepage": "https://secantlabs.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secantlabs/secantlabsmonorepo.git"
  },
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/landing",
    "dev:warp": "npm run dev -w apps/warp",
    "dev:lessons": "npm run dev -w apps/lessons",
    "dev:flux": "npm run dev -w apps/flux",
    "build": "npm run build -w apps/landing && npm run build -w apps/warp && npm run build:flux && npm run assemble:flux",
    "build:flux": "npm run build -w apps/flux",
    "assemble:flux": "mkdir -p apps/landing/dist/flux && cp -R apps/flux/dist/. apps/landing/dist/flux/",
    "test": "npm run test -w packages/engine"
  }
}
